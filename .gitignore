# Portable runtime + service wrapper binaries — download separately, don't commit
runtime/*
!runtime/.gitkeep
nssm/*
!nssm/.gitkeep

# Local app state — never commit real credentials/history
data/*
!data/.gitkeep

# Logs
logs/*
!logs/.gitkeep
*.log

# TLS material
certs/*.crt
certs/*.key
certs/*.pem
certs/*.p12
certs/*.pfx

# Dependencies
node_modules/

# Build artifacts
*.zip

# OS/editor cruft
.DS_Store
Thumbs.db
*.tmp
*.code-workspace

# Internal security working notes — these describe UNPATCHED vulnerabilities in
# actionable detail. Do not commit to a repo with a public remote while any
# finding remains open. Revisit once C2 (credential store re-key) has shipped.
SECURITY_REVIEW.md
CC_SECURITY_FIX_PROMPTS.md

# One-shot prompt-launcher scratch files — not durable project documentation,
# superseded by the spec doc they kicked off (e.g. AZURE_BLOB_PROFILE.md)
CC_PROMPT_*.md

# Internal-only docs — name the employer, internal vendor names, or service
# account identifiers (AmeriLife, Arcus, srv_datamover), or are internal working
# notes not meant for a public remote. Kept local, never pushed to the public remote.
CLAUDE.md
CLAUDE-cloud.md
GS_IMPORT_RULES.md
PROJECT_INSTRUCTIONS.md
AZURE_BLOB_PROFILE.md
BACKLOG.md
DEV_NOTES.md
SESSION_LOGS.md

# Test suite — not part of the public deliverable
tests/
